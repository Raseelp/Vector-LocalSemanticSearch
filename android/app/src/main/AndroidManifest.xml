<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <!-- Only for pre-Android-13 devices, where READ_MEDIA_* above didn't
         exist yet - capped with maxSdkVersion so Play doesn't see this as
         requesting broad legacy storage access on modern API levels where
         the scoped permissions already cover it. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- "Save a copy" (the full-screen viewer's actions sheet) writes to
         MediaStore, which needs this on pre-scoped-storage devices only -
         same maxSdkVersion pattern as READ_EXTERNAL_STORAGE above. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- "Set as wallpaper" in the same actions sheet - a normal permission,
         no runtime prompt. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <!-- Needed in every build type (not just debug) so ModelManager can
         download the CLIP weights on first run. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Keeps a scan alive in the background: a visible notification while
         indexing runs, so the OS (and battery-happy OEM task killers) don't
         treat the app as idle and kill it mid-scan. specialUse, not
         mediaProcessing - mediaProcessing is the type this app's actual
         function matches on paper, but on this device (and presumably the
         same Android 15 build/OEM combo for other users) the OS itself
         rejects it at the moment a foreground service actually tries to
         start with that type: android.app.InvalidForegroundServiceTypeException
         ("Starting FGS with type unknown ... has been prohibited"), which
         WorkManager's own SystemForegroundService doesn't catch, so it
         crashes the whole process. specialUse doesn't hit that same
         rejection and is what this app used successfully before this
         WorkManager migration - see PROPERTY_SPECIAL_USE_FGS_SUBTYPE below
         for the justification Play review will want. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Keeps the CPU from suspending mid-scan once the screen turns off -
         a foreground service alone only keeps the process alive, not the
         CPU awake. See ScanForegroundService's wake lock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>


    <application
        android:label="Vector"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Flutter Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hears that a scan's notification was swiped away, so it is not put back. -->
        <receiver
            android:name=".embedder.NotificationDismissReceiver"
            android:exported="false" />

        <!-- SAF Folder Picker Activity (NOT launcher) -->
        <activity
            android:name=".SafPickerActivity"
            android:exported="false" />

        <!-- The scan itself now runs as WorkManager work (see ScanWorker),
             not a Service this app declares directly - WorkManager starts
             its own internal foreground service for that. This just tells
             it which type to use, merged with WorkManager's own manifest
             entry for the same service. ScanForegroundService is now a
             plain singleton (notification/progress/wake-lock), not a
             Service - see its doc. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="specialUse"
            tools:node="merge">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device photo/video indexing: generates CLIP embeddings from the folders the user picked, so search stays available even while the app is backgrounded." />
        </service>

        <!-- Flutter embedding metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- Required by Flutter text processing -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>
